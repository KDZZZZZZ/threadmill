{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.cache/node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts"
  ]
}
