#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"
work_root="${THREADMILL_BENCHMARK_HOME:-$repo_root/benchmarks/.work}"
binary="${THREADMILL_BINARY:-$work_root/harbor/bin/threadmill}"
jobs_root="${THREADMILL_BENCHMARK_JOBS:-$work_root/jobs/${THREADMILL_BENCHMARK_NAME:-harbor}}"
runtime="${THREADMILL_HARBOR_BIN:-harbor}"
workspace_isolation_compose="$repo_root/benchmarks/harbor/docker-compose-workspace-isolation.yaml"
build_proxy_compose="$repo_root/benchmarks/harbor/docker-compose-build-proxy.yaml"

usage() {
  cat <<'EOF'
Usage:
  benchmarks/harbor/bench doctor [--image <pinned-task-image>] [--tracer <static-strace>]
  benchmarks/harbor/bench build
  benchmarks/harbor/bench test
  benchmarks/harbor/bench cache-ab <prepare|run|report|audit> [args...]
  benchmarks/harbor/bench run-path <task-or-dataset-path> <provider/model> [Harbor args...]
  benchmarks/harbor/bench run-dataset <dataset[@version]> <provider/model> [Harbor args...]
EOF
}

die() {
  printf 'threadmill-harbor: %s\n' "$*" >&2
  exit 1
}

doctor() {
  local runtime_entry runtime_python
  runtime_entry="$(readlink -f -- "$(command -v "$runtime")")"
  runtime_python="$(dirname -- "$runtime_entry")/python"
  [[ -x "$runtime_python" ]] || die "cannot locate Harbor's Python interpreter"
  PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
    "$runtime_python" -m benchmarks.harbor.doctor --binary "$binary" --runtime "$runtime" "$@"
}

build() {
  mkdir -p -- "$(dirname -- "$binary")"
  (cd "$repo_root" && CGO_ENABLED=0 go build -trimpath -o "$binary" ./cmd/threadmill)
  printf '%s\n' "$binary"
}

run_adapter() {
  local source_flag="$1"
  local source="$2"
  local model="$3"
  shift 3
  if [[ -z "${THREADMILL_BINARY:-}" ]]; then
    build >/dev/null
  fi
  [[ -f "$binary" ]] || die "missing binary: $binary"
  mkdir -p -- "$jobs_root"

  local version
  version="$(git -C "$repo_root" describe --always --dirty)"
  local -a adapter_args=(--agent benchmarks.harbor.threadmill_agent:Threadmill)
  if [[ "${runtime##*/}" == pier ]]; then
    adapter_args=(--agent-import-path benchmarks.harbor.threadmill_pier_agent:Threadmill)
  fi
  local -a agent_args=(
    "${adapter_args[@]}"
    --model "$model"
    --agent-kwarg "binary=$binary"
    --agent-kwarg "version=$version"
  )
  local -a compose_args=(
    --extra-docker-compose "$workspace_isolation_compose"
  )
  if [[ -n "${THREADMILL_BUILD_PROXY:-}" ]]; then
    compose_args+=(--extra-docker-compose "$build_proxy_compose")
  fi
  if [[ "${runtime##*/}" == pier ]]; then
    compose_args=(--environment-import-path benchmarks.harbor.threadmill_pier_environment:ThreadmillDockerEnvironment)
  fi
  if [[ -n "${THREADMILL_BENCH_WORKSPACE:-}" ]]; then
    agent_args+=(--agent-kwarg "workspace=$THREADMILL_BENCH_WORKSPACE")
  fi
  if [[ -n "${THREADMILL_CONTEXT_WINDOW:-}" ]]; then
    agent_args+=(--agent-kwarg "context_window=$THREADMILL_CONTEXT_WINDOW")
  fi
  if [[ -n "${THREADMILL_EXEC_SLOTS:-}" ]]; then
    agent_args+=(--agent-kwarg "exec_slots=$THREADMILL_EXEC_SLOTS")
  fi
  if [[ -n "${THREADMILL_MODEL_PROXY:-}" ]]; then
    agent_args+=(--agent-kwarg "model_proxy=$THREADMILL_MODEL_PROXY")
  fi
  if [[ -n "${THREADMILL_BENCH_CONFIG:-}" ]]; then
    agent_args+=(--agent-kwarg "config=$THREADMILL_BENCH_CONFIG")
  fi
  if [[ -n "${THREADMILL_STRACE_BINARY:-}" ]]; then
    agent_args+=(--agent-kwarg "tracer=$THREADMILL_STRACE_BINARY")
  fi
  if [[ -n "${THREADMILL_CACHE_MODE:-}" ]]; then
    agent_args+=(--agent-kwarg "cache_mode=$THREADMILL_CACHE_MODE")
  fi

  PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
    "$runtime" run "$source_flag" "$source" \
    "${agent_args[@]}" \
    "${compose_args[@]}" \
    --jobs-dir "$jobs_root" --yes "$@"
}

case "${1:-}" in
  doctor)
    doctor "${@:2}"
    ;;
  build)
    build
    ;;
  test)
    harbor_entry="$(readlink -f -- "$(command -v "$runtime")")"
    harbor_python="$(dirname -- "$harbor_entry")/python"
    [[ -x "$harbor_python" ]] || die "cannot locate Harbor's Python interpreter"
    test_module=benchmarks.harbor.test_threadmill_agent
    if [[ "${runtime##*/}" == pier ]]; then
      test_module=benchmarks.harbor.test_threadmill_pier_agent
    fi
    (cd "$repo_root" && "$harbor_python" -m unittest "$test_module" benchmarks.harbor.test_cache_ab -v)
    ;;
  cache-ab)
    harbor_entry="$(readlink -f -- "$(command -v "$runtime")")"
    harbor_python="$(dirname -- "$harbor_entry")/python"
    [[ -x "$harbor_python" ]] || die "cannot locate Harbor's Python interpreter"
    PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
      "$harbor_python" -m benchmarks.harbor.cache_ab "${@:2}"
    ;;
  run-path)
    [[ $# -ge 3 ]] || { usage >&2; exit 2; }
    run_adapter --path "$2" "$3" "${@:4}"
    ;;
  run-dataset)
    [[ $# -ge 3 ]] || { usage >&2; exit 2; }
    run_adapter --dataset "$2" "$3" "${@:4}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
